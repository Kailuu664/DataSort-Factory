[node name="Label2" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=284567159]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "━━━━━━━━━━━━━━
Sort LOWEST to HIGHEST.

THREE PHASES:
PHASE 1 — Sort the LEFT half
  Tap two crates then press PICK to swap.
  Repeat until crates 1-3 are in order.

PHASE 2 — Sort the RIGHT half
  Same mechanic for crates 4-6.

PHASE 3 — MERGE
  Press PICK to automatically grab the
  smaller front crate from either half
  and place it in the output row below.
  Repeat until all 6 slots are filled!

Gold crate = locked in correct position.
HINT = shows which crates to swap/pick."
horizontal_alignment = 1
autowrap_mode = 2

