; ─────────────────────────────────────────────────────────────────────────────
; Scene tree  (structure identical to original — only colors updated)
;
;  ProcessingMachine  (Node2D)
;  ├── Pipe / PipeCap  (Polygon2D)  ← exhaust pipe, darker steel
;  ├── SteamPuff       (Node2D)     ← animated steam cloud
;  │   ├── Puff1 / Puff2
;  ├── Body            (Polygon2D)  ← deep navy factory body
;  │   ├── BodyTopEdge             ← gold accent strip
;  │   ├── BodyBorderL/R/B         ← NEW: gold side/bottom border lines
;  │   ├── BodyShade               ← left shadow
;  │   ├── BoltTL/TR/BL/BR         ← gold-tinted hex bolts
;  │   ├── Screen      (Panel)     ← teal CRT terminal
;  │   │   ├── PctLabel
;  │   ├── Lights
;  │   │   ├── LightR / LightG / LightA
;  │   └── Vents
;  │       └── Vent1-5 + slats
;  ├── BasePlate / BasePlateEdge   ← gold top edge
;  ├── AnimationPlayer
;  ├── ShakeTimer
;  └── SteamTimer
; ─────────────────────────────────────────────────────────────────────────────

[node name="ProcessingMachine" type="Node2D"]
script = ExtResource("1_pm")

