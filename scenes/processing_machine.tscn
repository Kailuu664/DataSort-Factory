[gd_scene load_steps=15 format=3 uid="uid://proc_machine_datasort"]

[ext_resource type="Script" path="res://scripts/processing_machine.gd" id="1_pm"]

; ── Animations ────────────────────────────────────────────────────────────────
; idle_vibrate  : body shakes ±1 px continuously while active
; complete_flash: body flashes bright teal when 100 % reached

[sub_resource type="Animation" id="Anim_idle_vibrate"]
name = "idle_vibrate"
length = 0.4
loop_mode = 1
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Body:position")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0.0, 0.1, 0.2, 0.3, 0.4),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1),
"update": 0,
"values": [Vector2(0, 0), Vector2(-1, 1), Vector2(1, -1), Vector2(-1, -1), Vector2(0, 0)]
}

[sub_resource type="Animation" id="Anim_complete_flash"]
name = "complete_flash"
length = 0.6
loop_mode = 0
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Body:modulate")
tracks/0/interp = 1
tracks/0/loop_wrap = false
tracks/0/keys = {
"times": PackedFloat32Array(0.0, 0.15, 0.30, 0.45, 0.60),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1),
"update": 0,
"values": [Color(1,1,1,1), Color(0.4,2.0,0.8,1), Color(1,1,1,1), Color(0.4,2.0,0.8,1), Color(1,1,1,1)]
}

[sub_resource type="AnimationLibrary" id="AnimLib_pm"]
_data = {
"idle_vibrate": SubResource("Anim_idle_vibrate"),
"complete_flash": SubResource("Anim_complete_flash")
}

