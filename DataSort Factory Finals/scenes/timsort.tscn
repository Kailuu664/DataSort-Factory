[node name="Label2" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=460990616]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "━━━━━━━━━━━━━━
PHASE 1 — Set Run Boundaries
  Tap a crate to end Run 1.
  Tap another to end Run 2.
  Equal runs of 2 give the best score!

PHASE 2 — Sort Each Run
  Tap two crates inside the active run
  then press SWAP if out of order.

PHASE 3 — Choose Merge Order
  Tap two RUN buttons to pick which
  runs to merge first. Strategy matters!

PHASE 4 — First Merge
  Press PICK to grab the smaller front
  crate from either run into the temp row.

PHASE 5 — Final Merge
  Merge the temp result with the last run
  into the final output row. Press PICK!

Optimal: equal runs + smart merge order."
horizontal_alignment = 1
autowrap_mode = 2

