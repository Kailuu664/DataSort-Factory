[node name="Label2" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=145299577]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "━━━━━━━━━━━━━
Sort LOWEST to HIGHEST.
No comparisons — use digit buckets!
PASS 1 — ONES digit (right digit):
Tap each crate → tap its ones digit bucket.
Then press COLLECT.
PASS 2 — TENS digit (left digit):
Repeat — tap crate → tap tens bucket.
Then press COLLECT.
Result: fully sorted array!
HINT: shows you the correct bucket.
UNDO: removes last bucket placement."
horizontal_alignment = 1
autowrap_mode = 2

