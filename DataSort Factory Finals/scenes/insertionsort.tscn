[node name="Label2" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=488821312]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "━━━━━━━━━━━━━━
Sort LOWEST to HIGHEST.

LIKE SORTING CARDS:
Pick up the next crate and
slide it LEFT until it finds
its correct position.

STEP BY STEP:
1. Tap the next crate (▼ HERE)
   to pick it up.
2. Press SWAP to slide it
   one slot to the LEFT.
3. Keep sliding until the
   left neighbour is smaller.
4. Tap it again to lock it.
   Repeat for all crates.

Gold = locked in final position.
"
horizontal_alignment = 1
autowrap_mode = 2

