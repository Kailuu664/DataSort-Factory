[node name="Label2" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=8800009]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "━━━━━━━━━━━━━━
Sort LOWEST to HIGHEST.

LIKE INSERTION SORT — WITH GAPS:
Crates GAP positions apart are compared.
The GAP starts large (3) then shrinks to 1.

HOW IT WORKS:
1. Orange crate = LEFT (bigger, needs moving).
   Blue crate = RIGHT (smaller, correct pos).
2. Press SWAP when prompted — the crane
   moves the larger crate right by GAP steps.
3. Repeat until no more out-of-order pairs.
4. When GAP = 1, it's standard Insertion Sort.
   Sorted crates lock GOLD automatically.

SWAP is always automatic — just press it
when the instruction says ⚠️ !

Gold = locked in correct final position.
"
horizontal_alignment = 1
autowrap_mode = 2

