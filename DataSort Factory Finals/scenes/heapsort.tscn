[node name="BodyLabel" type="Label" parent="Howtoplaybtn/Instruction/PanelContainer/VBoxContainer" unique_id=97182624]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "━━━━━━━━━━━━━
Sort LOWEST to HIGHEST.
PHASE 1 — BUILD MAX-HEAP:
The guided system highlights which
parent/child pair to swap. Press SWAP
each time to move larger values up.
When the root is the maximum, Phase 1 ends.
PHASE 2 — EXTRACT:
The max (root) is swapped to the end
and locked. Press SWAP for each guided
step until all crates are sorted.
Blue = highlighted child  |  Orange = parent
Gold = locked / extracted"
horizontal_alignment = 1
autowrap_mode = 2

